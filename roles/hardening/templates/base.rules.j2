# 1. Сброс старых правил и настройка буфера ядра
-D
-b 8192

# 2. Точечные правила отслеживания
-w /usr/bin/sudo -p x -k sudo_execution
-w /usr/bin/passwd -p x -k passwdbin_watch

-w /etc/passwd -p wa -k passwd_watch

-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/sudoers.d -p wa -k sudoers_changes

-w /etc/crontab -p wa -k cron_watch
-w /etc/cron.d -p wa -k cron_watch
-w /etc/cron.daily -p wa -k cron_watch
-w /etc/cron.hourly -p wa -k cron_watch
-w /etc/cron.weekly -p wa -k cron_watch
-w /etc/cron.monthly -p wa -k cron_watch
-w /var/spool/cron/crontabs -p wa -k cron_watch

-w /etc/systemd/system -p wa -k systemd_watch
-w /lib/systemd/system -p wa -k systemd_watch
-w /usr/lib/systemd/system -p wa -k systemd_watch

# 3. Общий перехват системных вызовов
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=4294967295 -k exec_commands
